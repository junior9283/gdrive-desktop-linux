{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gdrive-desktop-linux",
  "identifier": "io.github.junior9283.GDriveDesktopLinux",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
