[Desktop Entry]
Type=Application
Name=Google Drive
Comment=Opens Google Docs pointers in the browser
Comment[pt_BR]=Abre os ponteiros dos Documentos Google no navegador
Exec=/usr/bin/gdrive-desktop-linux open-pointer %f
NoDisplay=true
Terminal=false
MimeType=application/x-gdrive-document;application/x-gdrive-spreadsheet;application/x-gdrive-presentation;application/x-gdrive-form;application/x-gdrive-drawing;application/x-gdrive-map;application/x-gdrive-site;application/x-gdrive-script;application/x-gdrive-jam;application/x-gdrive-link;
