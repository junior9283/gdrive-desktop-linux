[Desktop Entry]
Type=Application
Name=Uninstall Google Drive
Name[pt_BR]=Desinstalar Google Drive
Comment=Removes Google Drive from this computer
Comment[pt_BR]=Remove o Google Drive deste computador
Exec=/usr/bin/gdrive-desktop-linux-ui --open uninstall
Icon=io.github.junior9283.GDriveDesktopLinux
Terminal=false
